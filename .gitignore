# 1. 指定されたルートディレクトリのtempフォルダを無視
/temp/

# =======================================================
# 2. Unityプロジェクトの標準的な無視ルール (unity_let's_go サブディレクトリに適用)
# =======================================================

# Unityが自動生成するディレクトリを無視
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# メモリキャプチャファイルを無視
[Mm]emoryCaptures/

# Unity3Dが生成するメタデータファイルを無視
*.pidb.meta
*.pdb.meta
*.mdb.meta

# OSが生成する隠しファイルを無視 (Mac/Windows)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEやエディタが生成するプロジェクトファイルを無視 (Visual Studio / Rider / VS Code)
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# 自動生成される JetBrains Rider プラグインを無視
[Aa]ssets/Plugins/Editor/JetBrains*

# VS Code 関連のローカル設定を無視
.vscode/